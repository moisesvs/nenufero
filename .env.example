# Simulated checkout is the default. Never put live Stripe keys in source control.
PAYMENT_MODE=simulated
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_BASE_URL=http://127.0.0.1:8765

# Acceso al panel local /admin/ (mínimo 12 caracteres; no subir secretos a GitHub).
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Real prices in euro cents per SKU. Required before enabling live checkout.
# Example only; replace every value with Nenufero's approved prices.
STRIPE_LIVE_RATES_EUR_CENTS={}

# Optional real shipping rate in euro cents. Required only for delivery checkout.
STRIPE_SHIPPING_EUR_CENTS=
