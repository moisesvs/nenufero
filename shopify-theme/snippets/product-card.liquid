<article class="product-card"><a class="product-card-image" href="{{ product.url }}">{% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 900 | image_tag: widths: '320, 480, 640, 900', sizes: '(min-width: 900px) 25vw, (min-width: 600px) 45vw, 90vw', loading: 'lazy', alt: product.featured_image.alt }}{% else %}<span class="product-placeholder"><img src="{{ 'nenufero-logo.png' | asset_url }}" alt="{{ shop.name | escape }}"></span>{% endif %}{% unless product.available %}<span class="product-badge">Agotado</span>{% elsif product.compare_at_price > product.price %}<span class="product-badge">Oferta</span>{% endunless %}</a><div class="product-card-meta"><div><a href="{{ product.url }}"><h3>{{ product.title | escape }}</h3></a>{% if section.settings.show_vendor %}<p class="product-vendor">{{ product.vendor | escape }}</p>{% endif %}</div><span class="product-card-price">{% if product.price_varies %}Desde {{ product.price_min | money }}{% else %}{{ product.price | money }}{% endif %}</span></div><div class="product-card-actions">{% if product.available and product.variants.size == 1 %}{% form 'product', product, class: 'product-form product-form-quick' %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}"><input type="hidden" name="quantity" value="1"><button class="text-link" type="submit">Añadir al carrito <span aria-hidden="true">↗</span></button>{% endform %}{% elsif product.available %}<a class="text-link" href="{{ product.url }}">Elegir opciones <span aria-hidden="true">↗</span></a>{% else %}<span class="product-unavailable">No disponible</span>{% endif %}</div></article>
