<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_paper }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <title>{{ page_title }}{% if current_tags %} · {{ current_tags | join: ', ' }}{% endif %}{% unless page_title contains shop.name %} · {{ shop.name }}{% endunless %}</title>
    {% if page_description != blank %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
    {% render 'meta-tags' %}
    {% if settings.favicon != blank %}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64 }}">{% else %}<link rel="icon" href="{{ 'nenufero-logo.png' | asset_url }}" type="image/png">{% endif %}
    {% style %}
      {{ settings.type_body_font | font_face: font_display: 'swap' }}
      {{ settings.type_body_font | font_modify: 'weight', '500' | font_face: font_display: 'swap' }}
      {{ settings.type_body_font | font_modify: 'weight', '600' | font_face: font_display: 'swap' }}
      {{ settings.type_body_font | font_modify: 'weight', '700' | font_face: font_display: 'swap' }}
      :root{--paper:{{ settings.color_paper }};--ink:{{ settings.color_ink }};--blue:{{ settings.color_blue }};--line:{{ settings.color_line }};--font-body-family:{{ settings.type_body_font.family }},{{ settings.type_body_font.fallback_families }}}
    {% endstyle %}
    {{ 'theme.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'brand.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
    <script>
      window.nenuferoTheme = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }}
        },
        whatsapp: {{ settings.whatsapp_phone | json }},
        moneyFormat: {{ shop.money_format | json }}
      };
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </head>
  <body class="template-{{ template.name | handle }}">
    <a class="skip-link" href="#MainContent">Saltar al contenido</a>
    {% sections 'header-group' %}
    <main id="MainContent" role="main" tabindex="-1">{{ content_for_layout }}</main>
    {% sections 'footer-group' %}
    {% section 'cart-drawer' %}
  </body>
</html>
