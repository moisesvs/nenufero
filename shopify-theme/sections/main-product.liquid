<section class="product-page section-shell" data-product-section>
  <script type="application/ld+json">{{ product | structured_data }}</script>
  <nav class="breadcrumbs" aria-label="Ruta"><a href="{{ routes.root_url }}">Inicio</a><span>/</span>{% if collection %}<a href="{{ collection.url }}">{{ collection.title | escape }}</a><span>/</span>{% endif %}<span aria-current="page">{{ product.title | escape }}</span></nav>
  <div class="product-detail-grid"><div class="product-gallery">{% for media in product.media %}<div class="product-media">{% case media.media_type %}{% when 'image' %}{{ media | image_url: width: 1400 | image_tag: widths: '500, 800, 1100, 1400', sizes: '(min-width: 800px) 55vw, 100vw', loading: 'lazy', alt: media.alt }}{% when 'video' %}{{ media | video_tag: controls: true, image_size: '1000x' }}{% when 'external_video' %}{{ media | external_video_tag }}{% else %}{{ media | media_tag }}{% endcase %}</div>{% else %}<div class="product-placeholder product-placeholder-large"><img src="{{ 'nenufero-logo.png' | asset_url }}" alt="{{ shop.name | escape }}"></div>{% endfor %}</div>
    <div class="product-detail-copy"><p class="eyebrow">{{ product.vendor | default: shop.name | escape }}</p><h1>{{ product.title | escape }}</h1>{% if product.description != blank %}<div class="product-description rte">{{ product.description }}</div>{% endif %}<div class="product-current-price" data-product-price>{{ product.selected_or_first_available_variant.price | money }}</div>{% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}<s class="product-compare-price" data-product-compare>{{ product.selected_or_first_available_variant.compare_at_price | money }}</s>{% else %}<s class="product-compare-price" data-product-compare hidden></s>{% endif %}
      {% form 'product', product, class: 'product-form product-form-detail', data-product-form: '' %}{% if product.has_only_default_variant %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-variant-id>{% else %}<label class="variant-label" for="VariantSelect-{{ section.id }}">{{ section.settings.variant_label | escape }}</label><select id="VariantSelect-{{ section.id }}" name="id" data-variant-id>{% for variant in product.variants %}<option value="{{ variant.id }}" data-price="{{ variant.price | money | escape }}" data-compare-price="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | escape }}{% endif %}" data-available="{{ variant.available }}"{% if variant.id == product.selected_or_first_available_variant.id %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>{{ variant.title | escape }}{% unless variant.available %} · Agotado{% endunless %}</option>{% endfor %}</select>{% endif %}<label class="variant-label" for="ProductQuantity-{{ section.id }}">Cantidad</label><input id="ProductQuantity-{{ section.id }}" class="product-quantity" type="number" name="quantity" min="1" value="1"><button class="button button-blue product-submit" type="submit" name="add"{% unless product.available %} disabled{% endunless %}>{% if product.available %}Añadir al carrito{% else %}Agotado{% endif %} <span aria-hidden="true">↗</span></button><p class="product-form-message" data-product-message aria-live="polite"></p>{% endform %}
      {% if section.settings.show_sku and product.selected_or_first_available_variant.sku != blank %}<p class="product-sku">Referencia: {{ product.selected_or_first_available_variant.sku | escape }}</p>{% endif %}
      <div class="product-accordions">{% if shop.shipping_policy.body != blank %}<details><summary>Envío y recogida <span>+</span></summary><div class="policy-copy rte">{{ shop.shipping_policy.body }}</div></details>{% endif %}{% if shop.refund_policy.body != blank %}<details><summary>Devoluciones <span>+</span></summary><div class="policy-copy rte">{{ shop.refund_policy.body }}</div></details>{% endif %}</div>
    </div></div>
</section>
{% schema %}
{"name":"Producto","settings":[{"type":"text","id":"variant_label","label":"Etiqueta de opciones","default":"Elige una opción"},{"type":"checkbox","id":"show_sku","label":"Mostrar referencia del producto","default":false}],"presets":[{"name":"Producto"}]}
{% endschema %}
