<section class="cart-page section-shell"><nav class="breadcrumbs" aria-label="Ruta"><a href="{{ routes.root_url }}">Inicio</a><span>/</span><span aria-current="page">Tu carrito</span></nav><div class="cart-heading"><p class="eyebrow">TU SELECCIÓN</p><h1>Mi pedido <span>({{ cart.item_count }})</span></h1></div>{% if cart.item_count > 0 %}{% form 'cart', cart, class: 'cart-form' %}<div class="cart-lines">{% for item in cart.items %}<article class="cart-line"><a class="cart-line-image" href="{{ item.url }}">{% if item.image %}{{ item.image | image_url: width: 240 | image_tag: widths: '120, 240', loading: 'lazy', alt: item.image.alt }}{% endif %}</a><div class="cart-line-info"><a href="{{ item.url }}"><h2>{{ item.product.title | escape }}</h2></a>{% unless item.variant.title contains 'Default' %}<p>{{ item.variant.title | escape }}</p>{% endunless %}{% for property in item.properties %}{% assign property_prefix = property.first | slice: 0 %}{% unless property.last == blank or property_prefix == '_' %}<p class="cart-property">{{ property.first | escape }}: {% if property.last contains 'http' %}<a href="{{ property.last | escape }}" target="_blank" rel="noreferrer">Ver archivo</a>{% else %}{{ property.last | escape }}{% endif %}</p>{% endunless %}{% endfor %}{% if item.selling_plan_allocation %}<p>{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>{% endif %}<p>{{ item.final_price | money }}</p><a class="remove-item" href="{{ item.url_to_remove }}">Quitar</a></div><label class="cart-quantity">Cantidad<input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Cantidad de {{ item.product.title | escape }}"></label><span class="cart-line-total">{{ item.final_line_price | money }}</span></article>{% endfor %}</div><div class="cart-summary"><button class="text-link" type="submit" name="update">Actualizar carrito</button><div><p>Subtotal <strong>{{ cart.total_price | money }}</strong></p><p class="cart-note">Los impuestos y el envío se calculan al pagar.</p><button class="button button-blue" type="submit" name="checkout">Continuar al pago <span aria-hidden="true">↗</span></button></div></div>{% endform %}{% else %}<div class="empty-cart"><span class="proof-mark"><img src="{{ 'nenufero-logo.png' | asset_url }}" alt=""></span><h2>Tu carrito está esperando una buena idea.</h2><p>Explora la colección y añade tus favoritos.</p><a class="button button-dark" href="{{ routes.all_products_collection_url }}">Ver la tienda <span aria-hidden="true">↗</span></a></div>{% endif %}</section>
{% schema %}
{"name":"Carrito","settings":[],"presets":[{"name":"Carrito"}]}
{% endschema %}
