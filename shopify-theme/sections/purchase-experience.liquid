<section class="purchase-experience section-shell purchase-{{ section.settings.visual }}">
  <nav class="breadcrumbs" aria-label="Ruta"><a href="{{ routes.root_url }}">Inicio</a><span>/</span><a href="{{ routes.root_url }}pages/tienda-online">Tienda online</a><span>/</span><span aria-current="page">{{ page.title | escape }}</span></nav>
  <header class="purchase-experience-hero"><div class="purchase-experience-copy"><p class="eyebrow"><span class="status-dot"></span>{{ section.settings.kicker | escape }}</p><h1>{{ section.settings.heading | escape | newline_to_br }}</h1><div class="experience-description rte">{{ section.settings.copy }}</div><div class="experience-trust"><span>01&nbsp; Asesoramiento del taller</span><span>02&nbsp; Precio confirmado antes de producir</span></div></div><div class="purchase-experience-art"><span class="purchase-art-orbit"></span>{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1100 | image_tag: widths: '500, 750, 1100', sizes: '(min-width: 800px) 45vw, 100vw', loading: 'eager', alt: section.settings.image.alt }}{% else %}<img src="{{ 'nenufero-logo.png' | asset_url }}" alt="{{ shop.name | escape }}">{% endif %}<span>{{ section.settings.image_caption | escape }}</span></div></header>
  {% if section.settings.mode == 'quote' %}
    <section class="purchase-request"><div><p class="eyebrow">Primer contacto</p><h2>Cuéntanos lo esencial.</h2><p>{{ section.settings.request_note | escape }}</p><a href="mailto:{{ shop.email | escape }}">Escribir por email <span>↗</span></a></div><form class="quote-form purchase-request-form" data-whatsapp-form data-shop-email="{{ shop.email | escape }}"><div class="form-row"><label>Tu nombre<input name="name" autocomplete="name" placeholder="¿Cómo te llamas?" required></label><label>Tu teléfono<input name="phone" autocomplete="tel" type="tel" placeholder="Para poder responderte" required></label></div><label>Tu email<input name="email" autocomplete="email" type="email" placeholder="nombre@empresa.com"></label><label>¿Qué quieres hacer?<select name="service" required><option value="" disabled selected>Elige una opción</option><option>Camisetas, tazas u objetos personalizados</option><option>Rótulo o logotipo retroiluminado</option><option>Vinilos, lonas o gran formato</option><option>Vinilo por metros</option><option>PVC o metacrilato cortado y fresado</option><option>Corte láser</option><option>Otra idea</option></select></label><label>Cuéntanos tu idea<textarea name="details" rows="4" placeholder="Qué quieres hacer, para qué espacio y cuántas unidades…" required></textarea></label><label>Fecha preferida para visitar el taller<input name="visit" type="datetime-local" data-visit-date></label><p class="field-hint">La visita queda pendiente de confirmación.</p><label class="upload-field">Imagen o archivo de referencia<input name="reference" type="file" accept="image/*,.pdf,.svg,.ai,.eps" data-quote-file><span class="upload-hint">JPG, PNG, PDF, SVG, AI o EPS · Hasta 20 MB</span><span class="upload-preview" data-quote-preview aria-live="polite">Todavía no has seleccionado ningún archivo.</span></label><p class="form-error" data-form-error aria-live="polite"></p><div class="quote-actions"><button class="button button-blue form-submit" type="submit">Preparar consulta por WhatsApp <span>↗</span></button><button class="button button-dark form-submit" type="button" data-email-submit>Preparar email <span>↗</span></button></div><p class="form-note">En móviles compatibles, comparte el archivo con WhatsApp. Por email, adjúntalo manualmente. Para comprar un producto, súbelo en su ficha y continúa al checkout.</p></form></section>
  {% else %}
    {% assign experience_collection = section.settings.collection %}
    <section class="experience-catalog"><div class="experience-catalog-heading"><div><p class="eyebrow">{{ section.settings.catalog_kicker | escape }}</p><h2>{{ section.settings.catalog_heading | escape }}</h2></div><span class="catalog-count">{% if experience_collection != blank %}{{ experience_collection.products_count }} productos{% else %}Catálogo Shopify{% endif %}</span></div>
      {% if experience_collection != blank and experience_collection.products_count > 0 %}<div class="product-grid">{% for product in experience_collection.products %}{% render 'product-card', product: product %}{% endfor %}</div><a class="collection-footer text-link" href="{{ experience_collection.url }}">Ver la colección completa <span>↗</span></a>
      {% else %}<div class="experience-empty"><span class="proof-mark"><img src="{{ 'nenufero-logo.png' | asset_url }}" alt=""></span><h3>{{ section.settings.empty_heading | escape }}</h3><p>{{ section.settings.empty_copy | escape }}</p></div>{% endif %}
      <p class="experience-checkout-note">Los productos con precio y variante confirmados se pagan en el checkout de Shopify. Para medidas o acabados fuera del catálogo, contacta con el taller antes de comprar.</p>
    </section>
  {% endif %}
  <section class="experience-steps"><p class="eyebrow">Cómo funciona</p><div class="experience-step-grid">{% for block in section.blocks %}{% if block.type == 'step' %}<article {{ block.shopify_attributes }}><span>0{{ forloop.index }}</span><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.copy | escape }}</p></article>{% endif %}{% endfor %}</div></section>
  {% assign faq_blocks = section.blocks | where: 'type', 'faq' %}{% if faq_blocks.size > 0 %}<section class="experience-faq"><p class="eyebrow">Respuestas claras</p><div>{% for block in faq_blocks %}<details {{ block.shopify_attributes }}><summary>{{ block.settings.question | escape }}<span>+</span></summary><p>{{ block.settings.answer | escape }}</p></details>{% endfor %}</div></section>{% endif %}
</section>
{% schema %}
{"name":"Experiencia de compra","settings":[{"type":"select","id":"mode","label":"Tipo de experiencia","options":[{"value":"catalog","label":"Catálogo y compra"},{"value":"quote","label":"Proyecto y presupuesto"}],"default":"catalog"},{"type":"select","id":"visual","label":"Tratamiento visual","options":[{"value":"shirt","label":"Personalizados"},{"value":"sign","label":"Rótulo luminoso"},{"value":"format","label":"Gran formato"},{"value":"vinyl","label":"Vinilo"},{"value":"sheet","label":"Planchas"},{"value":"laser","label":"Corte láser"},{"value":"idea","label":"Proyecto"}],"default":"vinyl"},{"type":"text","id":"kicker","label":"Introducción","default":"Materiales para producir"},{"type":"textarea","id":"heading","label":"Titular","default":"Configura tu pedido."},{"type":"richtext","id":"copy","label":"Descripción","default":"<p>Elige el material, consulta opciones disponibles y añade los productos que necesitas al carrito.</p>"},{"type":"image_picker","id":"image","label":"Imagen de la experiencia"},{"type":"text","id":"image_caption","label":"Pie de imagen","default":"HECHO EN MADRID"},{"type":"text","id":"catalog_kicker","label":"Introducción del catálogo","default":"Elige material y acabado"},{"type":"text","id":"catalog_heading","label":"Título del catálogo","default":"Productos disponibles"},{"type":"collection","id":"collection","label":"Colección Shopify"},{"type":"text","id":"empty_heading","label":"Título si no hay productos","default":"Estamos preparando esta colección."},{"type":"text","id":"empty_copy","label":"Descripción si no hay productos","default":"Asigna la colección de esta experiencia en el editor de Shopify para mostrar productos, variantes y precios."},{"type":"textarea","id":"request_note","label":"Descripción del formulario de proyecto","default":"Sube una referencia, describe lo que necesitas o solicita una visita al taller."}],"blocks":[{"type":"step","name":"Paso de compra","settings":[{"type":"text","id":"title","label":"Título","default":"Elige opciones"},{"type":"textarea","id":"copy","label":"Descripción","default":"Consulta variantes y disponibilidad desde la ficha de producto."}]},{"type":"faq","name":"Pregunta frecuente","settings":[{"type":"text","id":"question","label":"Pregunta","default":"¿Cuándo se confirma el precio?"},{"type":"textarea","id":"answer","label":"Respuesta","default":"El precio de la variante se muestra en Shopify. Los trabajos especiales pasan por presupuesto antes de pagar."}]}],"max_blocks":9,"presets":[{"name":"Experiencia de compra","blocks":[{"type":"step","settings":{"title":"Elige material","copy":"Compara variantes, acabados y disponibilidad."}},{"type":"step","settings":{"title":"Añade al carrito","copy":"El precio se actualiza con la variante disponible."}},{"type":"step","settings":{"title":"Paga online","copy":"Finaliza tu compra en el checkout de Shopify."}}]}]}
{% endschema %}
