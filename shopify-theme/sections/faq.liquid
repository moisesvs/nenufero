<section class="faq section-shell"><div class="faq-heading"><p class="eyebrow">{{ section.settings.kicker | escape }}</p><h2>{{ section.settings.heading | escape | newline_to_br }}</h2><a class="text-link" href="https://wa.me/{{ settings.whatsapp_phone | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')' }}" target="_blank" rel="noopener">{{ section.settings.contact_label | escape }} ↗</a></div><div class="faq-list">{% for block in section.blocks %}<details {{ block.shopify_attributes }}><summary>{{ block.settings.question | escape }}<span aria-hidden="true">+</span></summary><p>{{ block.settings.answer | escape }}</p></details>{% endfor %}</div></section>
{% schema %}
{"name":"Preguntas frecuentes","settings":[{"type":"text","id":"kicker","label":"Introducción","default":"Antes de empezar"},{"type":"textarea","id":"heading","label":"Titular","default":"Preguntas\nfrecuentes."},{"type":"text","id":"contact_label","label":"Enlace de contacto","default":"¿Tienes otra pregunta? Escríbenos"}],"blocks":[{"type":"question","name":"Pregunta","settings":[{"type":"text","id":"question","label":"Pregunta","default":"¿Cómo pido presupuesto para un trabajo personalizado?"},{"type":"textarea","id":"answer","label":"Respuesta","default":"Cuéntanos qué necesitas y concretaremos medidas, cantidades, materiales y acabados antes de preparar el presupuesto."}]}],"max_blocks":12,"presets":[{"name":"Preguntas frecuentes","blocks":[{"type":"question","settings":{"question":"¿Cómo pido presupuesto para un trabajo personalizado?","answer":"Cuéntanos qué necesitas. Concretaremos medidas, cantidades, materiales y acabados antes de preparar el presupuesto."}},{"type":"question","settings":{"question":"¿Puedo revisar el diseño antes de producir?","answer":"Sí. Acordamos la propuesta y los artes finales contigo antes de iniciar la producción."}},{"type":"question","settings":{"question":"¿Cuánto tarda un pedido?","answer":"El plazo depende del tipo de trabajo, las cantidades y la instalación. Te confirmaremos una fecha al preparar el presupuesto."}},{"type":"question","settings":{"question":"¿Puedo recoger mi pedido en el taller?","answer":"Estamos en Calle La del Manojo de Rosas 81, 28041 Madrid. Coordinamos la recogida cuando tu pedido esté listo."}}]}]}
{% endschema %}
