{% assign featured_collection = section.settings.collection | default: collections.all %}
<section class="shop section-shell" id="tienda"><div class="shop-heading"><div><p class="eyebrow">{{ section.settings.kicker | escape }}</p><h2>{{ section.settings.heading | escape | newline_to_br }}</h2></div><div class="shop-intro"><p>{{ section.settings.copy | escape }}</p><span class="edition-label"><span class="status-dot"></span> {{ section.settings.note | escape }}</span></div></div>
  {% if featured_collection != blank and featured_collection.products_count > 0 %}<div class="product-grid">{% for product in featured_collection.products limit: section.settings.limit %}{% render 'product-card', product: product %}{% endfor %}</div><div class="collection-footer"><span>CATÁLOGO NENUFERO / {{ featured_collection.products_count }} PRODUCTOS</span><a class="text-link" href="{{ featured_collection.url }}">Ver todos los productos ↗</a></div>{% else %}<div class="empty-products"><span class="proof-mark"><img src="{{ 'nenufero-logo.png' | asset_url }}" alt=""></span><h3>{{ section.settings.empty_title | escape }}</h3><p>{{ section.settings.empty_copy | escape }}</p></div>{% endif %}
</section>
{% schema %}
{"name":"Colección destacada","settings":[{"type":"text","id":"kicker","label":"Introducción","default":"La casa también se viste"},{"type":"textarea","id":"heading","label":"Titular","default":"Hecha para llevar.\nHecha por nosotros."},{"type":"textarea","id":"copy","label":"Descripción","default":"Descubre la colección propia de Nenufero. El precio, las opciones y la disponibilidad se muestran desde la tienda."},{"type":"text","id":"note","label":"Etiqueta","default":"COLECCIÓN PROPIA / NENUFERO"},{"type":"collection","id":"collection","label":"Colección"},{"type":"range","id":"limit","label":"Productos visibles","min":2,"max":12,"step":1,"default":4},{"type":"checkbox","id":"show_vendor","label":"Mostrar marca del producto","default":false},{"type":"text","id":"empty_title","label":"Mensaje sin productos","default":"Estamos preparando la colección."},{"type":"text","id":"empty_copy","label":"Descripción sin productos","default":"Elige una colección en el editor de la tienda para mostrar aquí sus productos."}],"presets":[{"name":"Colección destacada"}]}
{% endschema %}
