<section class="reviews"><div class="reviews-heading"><p class="eyebrow">{{ section.settings.kicker | escape }}</p><h2>{{ section.settings.heading | escape | newline_to_br }}</h2><p>{{ section.settings.note | escape }}</p></div><div class="review-list">{% for block in section.blocks %}<blockquote {{ block.shopify_attributes }}><p>«{{ block.settings.quote | escape }}»</p><footer><span class="review-avatar">{{ block.settings.name | slice: 0 | upcase }}</span><span><b>{{ block.settings.name | escape }}</b><small>Opinión de cliente</small></span><img class="review-mark" src="{{ 'nenufero-logo.png' | asset_url }}" alt="Nenufero"></footer></blockquote>{% endfor %}</div></section>
{% schema %}
{"name":"Opiniones de clientes","settings":[{"type":"text","id":"kicker","label":"Introducción","default":"Nos lo habéis contado"},{"type":"textarea","id":"heading","label":"Titular","default":"El trabajo habla.\nY vosotros también."},{"type":"text","id":"note","label":"Nota","default":"Opiniones publicadas por clientes de Nenufero."}],"blocks":[{"type":"review","name":"Opinión","settings":[{"type":"textarea","id":"quote","label":"Opinión","default":"Trabajo muy personalizado y siempre mejor de lo esperado. Trato y servicios de 10."},{"type":"text","id":"name","label":"Nombre","default":"Cliente de Nenufero"}]}],"max_blocks":6,"presets":[{"name":"Opiniones de clientes","blocks":[{"type":"review","settings":{"quote":"Son varios los pedidos que he hecho y muy contenta con el resultado, buen precio, variedad y buen trato al cliente.","name":"Sonia Vaz"}},{"type":"review","settings":{"quote":"Trabajo muy personalizado y siempre mejor de lo esperado. Trato y servicios de 10. Gracias, chicos.","name":"Eva"}}]}]}
{% endschema %}
