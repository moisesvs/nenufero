<section class="collection-page section-shell"><header class="collection-heading"><p class="eyebrow">BUSCAR EN NENUFERO</p><h1>Resultados de búsqueda</h1><form action="{{ routes.search_url }}" method="get" role="search" class="search-form"><label for="Search-{{ section.id }}">¿Qué estás buscando?</label><div><input id="Search-{{ section.id }}" type="search" name="q" value="{{ search.terms | escape }}"><button class="button button-dark" type="submit">Buscar ↗</button></div></form></header>{% if search.performed %}{% paginate search.results by 12 %}<div class="product-grid">{% for result in search.results %}{% if result.object_type == 'product' %}{% render 'product-card', product: result %}{% else %}<article class="search-result"><a href="{{ result.url }}"><span class="eyebrow">{{ result.object_type | escape }}</span><h2>{{ result.title | escape }}</h2></a></article>{% endif %}{% else %}<p>No encontramos resultados. Prueba con otra búsqueda.</p>{% endfor %}</div>{% if paginate.pages > 1 %}<nav class="pagination" aria-label="Paginación">{% if paginate.previous %}<a href="{{ paginate.previous.url }}">← Anterior</a>{% endif %}<span>{{ paginate.current_page }} / {{ paginate.pages }}</span>{% if paginate.next %}<a href="{{ paginate.next.url }}">Siguiente →</a>{% endif %}</nav>{% endif %}{% endpaginate %}{% endif %}</section>
{% schema %}
{"name":"Búsqueda","settings":[],"presets":[{"name":"Búsqueda"}]}
{% endschema %}
