<section class="quote-section section-shell" id="contacto"><div class="quote-heading"><p class="eyebrow">{{ section.settings.kicker | escape }}</p><h2>{{ section.settings.heading | escape | newline_to_br }}</h2><p>{{ section.settings.copy | escape }}</p><a class="contact-phone" href="tel:{{ settings.whatsapp_phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' }}">{{ settings.whatsapp_phone }} <span aria-hidden="true">↗</span></a></div><form class="quote-form" data-whatsapp-form><div class="form-row"><label>Tu nombre<input name="name" autocomplete="name" placeholder="¿Cómo te llamas?" required></label><label>Tu teléfono<input name="phone" autocomplete="tel" type="tel" placeholder="Para poder responderte" required></label></div><label>¿Qué necesitas?<select name="service" required><option value="" disabled selected>Elige un servicio</option><option>Rotulación</option><option>Impresión</option><option>Textil</option><option>Impresión UVI</option><option>Gran formato</option><option>Presencia digital</option><option>Otro proyecto</option></select></label><label>Cuéntanos un poco más<textarea name="details" rows="3" placeholder="Medidas, cantidad, fecha aproximada…" required></textarea></label><p class="form-error" data-form-error aria-live="polite"></p><button class="button button-dark form-submit" type="submit">Preparar mi consulta <span aria-hidden="true">↗</span></button><p class="form-note">Se abrirá WhatsApp con tu mensaje preparado para que lo revises antes de enviarlo.</p></form></section>
{% schema %}
{"name":"Presupuesto y contacto","settings":[{"type":"text","id":"kicker","label":"Introducción","default":"Empecemos con un hola"},{"type":"textarea","id":"heading","label":"Titular","default":"Cuéntanos qué\ntienes entre manos."},{"type":"textarea","id":"copy","label":"Descripción","default":"Un poco de contexto y te responderemos personalmente para avanzar con tu proyecto."}],"presets":[{"name":"Presupuesto y contacto"}]}
{% endschema %}
