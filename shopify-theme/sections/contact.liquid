<section class="quote-section section-shell" id="contacto"><div class="quote-heading"><p class="eyebrow">{{ section.settings.kicker | escape }}</p><h2>{{ section.settings.heading | escape | newline_to_br }}</h2><p>{{ section.settings.copy | escape }}</p><a class="contact-phone" href="tel:{{ settings.whatsapp_phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' }}">{{ settings.whatsapp_phone }} <span aria-hidden="true">↗</span></a><a class="contact-email" href="mailto:{{ shop.email | escape }}">{{ shop.email | escape }} <span aria-hidden="true">↗</span></a></div><form class="quote-form" data-whatsapp-form><div class="form-row"><label>Tu nombre<input name="name" autocomplete="name" placeholder="¿Cómo te llamas?" required></label><label>Tu teléfono<input name="phone" autocomplete="tel" type="tel" placeholder="Para poder responderte" required></label></div><label>Tu email<input name="email" autocomplete="email" type="email" placeholder="nombre@empresa.com"></label><label>¿Qué necesitas?<select name="service" required><option value="" disabled selected>Elige un servicio</option><option>Camisetas, tazas o productos personalizados</option><option>Logotipo o rótulo retroiluminado</option><option>Vinilos, lonas o gran formato</option><option>Vinilo por metros</option><option>PVC o metacrilato cortado y fresado</option><option>Corte láser</option><option>Quiero asesoramiento</option><option>Otro proyecto</option></select></label><label>Cuéntanos un poco más<textarea name="details" rows="3" placeholder="Medidas, cantidad, acabado y fecha aproximada…" required></textarea></label><label>Fecha preferida para visitar el taller<input name="visit" type="datetime-local" data-visit-date></label><p class="field-hint">La hora queda pendiente de confirmación por el equipo.</p><label class="upload-field">Imagen o archivo de referencia<input name="reference" type="file" accept="image/*,.pdf,.svg,.ai,.eps" data-quote-file><span class="upload-hint">JPG, PNG, PDF, SVG, AI o EPS · Hasta 20 MB</span><span class="upload-preview" data-quote-preview aria-live="polite">Todavía no has seleccionado ningún archivo.</span></label><p class="form-error" data-form-error aria-live="polite"></p><button class="button button-dark form-submit" type="submit">Preparar mi consulta <span aria-hidden="true">↗</span></button><p class="form-note">En móviles compatibles podrás compartir el archivo junto al mensaje de WhatsApp. Para adjuntarlo directamente a un producto del pedido, utiliza el campo de archivo de su ficha.</p></form></section>
{% schema %}
{"name":"Presupuesto y contacto","settings":[{"type":"text","id":"kicker","label":"Introducción","default":"Empecemos con un hola"},{"type":"textarea","id":"heading","label":"Titular","default":"Cuéntanos qué\ntienes entre manos."},{"type":"textarea","id":"copy","label":"Descripción","default":"Un poco de contexto y te responderemos personalmente para avanzar con tu proyecto."}],"presets":[{"name":"Presupuesto y contacto"}]}
{% endschema %}
