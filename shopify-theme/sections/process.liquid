<section class="process" id="proceso"><div class="process-wrap"><div class="process-intro"><p class="eyebrow">{{ section.settings.kicker | escape }}</p><h2>{{ section.settings.heading | escape | newline_to_br }}</h2><p>{{ section.settings.copy | escape }}</p></div><div class="steps">{% for block in section.blocks %}<article class="step" {{ block.shopify_attributes }}><span class="step-index">0{{ forloop.index }} / {{ block.settings.verb | escape }}</span><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.copy | escape }}</p><span class="step-mark" aria-hidden="true">{% if forloop.last %}✳{% else %}↗{% endif %}</span></article>{% endfor %}</div></div></section>
{% schema %}
{"name":"Cómo trabajamos","settings":[{"type":"text","id":"kicker","label":"Introducción","default":"Sin sorpresas"},{"type":"textarea","id":"heading","label":"Titular","default":"De la idea\nal hecho."},{"type":"textarea","id":"copy","label":"Descripción","default":"Un proceso claro, una persona al otro lado y la posibilidad de revisar antes de producir."}],"blocks":[{"type":"step","name":"Paso","settings":[{"type":"text","id":"verb","label":"Etiqueta","default":"ESCUCHAR"},{"type":"text","id":"title","label":"Título","default":"Lo hablamos"},{"type":"textarea","id":"copy","label":"Descripción","default":"Cuéntanos qué necesitas y te orientamos para elegir materiales y acabados."}]}],"max_blocks":4,"presets":[{"name":"Cómo trabajamos","blocks":[{"type":"step","settings":{"verb":"ESCUCHAR","title":"Lo hablamos","copy":"Cuéntanos qué necesitas, cuándo y qué tienes en mente. Te orientamos sin compromiso."}},{"type":"step","settings":{"verb":"PREPARAR","title":"Lo ponemos a prueba","copy":"Definimos materiales, medidas y acabado. Revisas la propuesta antes de aprobarla."}},{"type":"step","settings":{"verb":"HACER","title":"Lo hacemos realidad","copy":"Producimos en el taller y coordinamos contigo la recogida o instalación."}}]}]}
{% endschema %}
