<section class="services section-shell" id="servicios"><div class="section-heading"><div><p class="eyebrow">{{ section.settings.kicker | escape }}</p><h2>{{ section.settings.heading | escape | newline_to_br }}</h2></div><p class="section-aside">{{ section.settings.aside | newline_to_br }}</p></div><div class="service-grid">
  {% for block in section.blocks %}<a class="service-card" href="{{ block.settings.link | default: '#contacto' }}" {{ block.shopify_attributes }}><div class="service-art service-art-{{ forloop.index }}"><span class="service-art-mark"><img src="{{ 'nenufero-logo.png' | asset_url }}" alt=""></span><span class="art-tag">0{{ forloop.index }} / {{ block.settings.caption | escape }}</span></div><div class="service-meta"><div><span class="service-number">0{{ forloop.index }}</span><h3>{{ block.settings.title | escape }}</h3></div><span class="round-arrow" aria-hidden="true">↗</span></div><p>{{ block.settings.copy | escape }}</p></a>{% endfor %}
</div><a class="inline-cta" href="#contacto"><span>{{ section.settings.bottom_prompt | escape }}</span><span>{{ section.settings.bottom_link | escape }} <b>↗</b></span></a></section>
{% schema %}
{"name":"Servicios","settings":[{"type":"text","id":"kicker","label":"Introducción","default":"Lo hacemos visible"},{"type":"textarea","id":"heading","label":"Titular","default":"Todo lo que tu marca\nnecesita para salir ahí fuera."},{"type":"textarea","id":"aside","label":"Texto lateral","default":"De la primera prueba\nal último acabado."},{"type":"text","id":"bottom_prompt","label":"Pregunta","default":"¿No sabes por dónde empezar?"},{"type":"text","id":"bottom_link","label":"Enlace","default":"Te ayudamos a darle forma"}],"blocks":[{"type":"service","name":"Servicio","settings":[{"type":"text","id":"title","label":"Nombre","default":"Rotulación"},{"type":"text","id":"caption","label":"Etiqueta de imagen","default":"EN LA CALLE"},{"type":"textarea","id":"copy","label":"Descripción","default":"Vehículos, escaparates y espacios que trabajan para tu negocio."},{"type":"url","id":"link","label":"Enlace"}]}],"max_blocks":6,"presets":[{"name":"Servicios","blocks":[{"type":"service","settings":{"title":"Rotulación","caption":"EN LA CALLE","copy":"Vehículos, escaparates y espacios que trabajan para ti."}},{"type":"service","settings":{"title":"Impresión","caption":"TINTA Y PAPEL","copy":"Tarjetas, folletos y gran formato con un acabado que se nota."}},{"type":"service","settings":{"title":"Textil y UVI","caption":"A TU MANERA","copy":"Ropa de trabajo, prendas para tu marca y objetos personalizados."}},{"type":"service","settings":{"title":"Presencia digital","caption":"TAMBIÉN EN LÍNEA","copy":"Una identidad clara para que tu negocio se entienda en pantalla."}}]}]}
{% endschema %}
